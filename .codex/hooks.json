{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/format-on-edit.sh\"",
            "statusMessage": "Formatting and linting edited .nix files",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/scripts/stop-check.sh\"",
            "statusMessage": "Running scripts/check.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
